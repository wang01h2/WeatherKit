#!name = WeatherKit v3 补丁（实验版）
#!desc = 为 iRingo WeatherKit 添加 v3 响应支持；请保留原版模块，关闭其他 v3 补丁。

[Script]
WeatherKit v3 Response = type=http-response, pattern=^https?://weatherkit\.apple\.com/api/v3/weather/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/wang01h2/WeatherKit/main/v3/response.bundle.js

[MITM]
hostname = %APPEND% weatherkit.apple.com
